{
  "name": "mortar",
  "private": true,
  "packageManager": "bun@1.4.3",
  "workspaces": [
    "frontend",
    "web"
  ],
  "scripts": {
    "lint": "biome check --error-on-warnings .",
    "bindings": "wails3 generate bindings -clean=true -ts -i && bun scripts/erasable-bindings.ts",
    "typecheck": "bun run bindings && bun run --cwd frontend tsc --noEmit",
    "test": "GORACE=atexit_sleep_ms=0 go test -race ./... && bun test",
    "version:check": "go run ./cmd/version -check",
    "metainfo": "appstreamcli validate --strict --no-net build/linux/tech.rethunk.Mortar.metainfo.xml",
    "gate": "scripts/gate.sh",
    "e2e:updater": "go test -count=1 -tags updatetest -run TestUpdaterE2E ./internal/updatesvc",
    "perf": "MORTAR_PERF=1 go test -count=1 -run '^TestPerfBudgets$' ./internal/problems && MORTAR_PERF=1 bun test frontend/src/mods/useModGroups.test.ts",
    "mem": "scripts/mem-budget.sh",
    "renders": "scripts/render-budget.sh",
    "vuln": "govulncheck ./...",
    "site": "bun scripts/site.ts --check",
    "site:search": "pagefind --site site --output-subdir pagefind",
    "site:downloads": "bun scripts/site-downloads.ts",
    "i18n:dupes": "bun scripts/i18n-dupes.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "knip": "^6.41.0",
    "pagefind": "1.5.2"
  }
}
