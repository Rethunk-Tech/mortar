{
  "name": "mortar",
  "private": true,
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "lint": "biome check . && golangci-lint run",
    "typecheck": "bun run --cwd frontend tsc --noEmit",
    "test": "go test ./...",
    "vet": "go vet ./...",
    "gate": "bun run lint && bun run typecheck && bun run vet && bun run test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14"
  }
}
