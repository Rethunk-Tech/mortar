# Maintainer: Rethunk.Tech <security@rethunk.tech>
pkgname=mortar-bin
pkgver=0.2.0
pkgrel=1
pkgdesc='Desktop mod manager for Stardew Valley'
arch=('x86_64' 'aarch64')
url='https://github.com/Rethunk-Tech/mortar'
license=('AGPL-3.0-only')
depends=('glib2' 'glibc' 'gtk4' 'hicolor-icon-theme' 'libsoup3' 'libx11' 'webkitgtk-6.0' 'xdg-utils')
# A prebuilt binary: no debug split package, and makepkg must not re-strip it.
options=('!debug' '!strip')
provides=('mortar')
conflicts=('mortar')
source=(
  "mortar-${pkgver}.tar.gz::https://github.com/Rethunk-Tech/mortar/archive/refs/tags/v${pkgver}.tar.gz"
)
source_x86_64=(
  "mortar-aur-linux-amd64::https://github.com/Rethunk-Tech/mortar/releases/download/v${pkgver}/mortar-aur-linux-amd64"
)
source_aarch64=(
  "mortar-aur-linux-arm64::https://github.com/Rethunk-Tech/mortar/releases/download/v${pkgver}/mortar-aur-linux-arm64"
)
sha256sums=('SKIP')
sha256sums_x86_64=('SKIP')
sha256sums_aarch64=('SKIP')

package() {
  local bin=mortar-aur-linux-amd64
  if [[ $CARCH == aarch64 ]]; then
    bin=mortar-aur-linux-arm64
  fi
  install -Dm755 "$bin" "${pkgdir}/usr/bin/mortar"
  install -Dm644 "mortar-${pkgver}/build/linux/tech.rethunk.Mortar.desktop" \
    "${pkgdir}/usr/share/applications/tech.rethunk.Mortar.desktop"
  install -Dm644 "mortar-${pkgver}/build/linux/mime/mortar.xml" \
    "${pkgdir}/usr/share/mime/packages/mortar.xml"
  install -Dm644 "mortar-${pkgver}/build/linux/icons/tech.rethunk.Mortar-512.png" \
    "${pkgdir}/usr/share/icons/hicolor/512x512/apps/tech.rethunk.Mortar.png"
  install -Dm644 "mortar-${pkgver}/build/linux/icons/tech.rethunk.Mortar-256.png" \
    "${pkgdir}/usr/share/icons/hicolor/256x256/apps/tech.rethunk.Mortar.png"
  install -Dm644 "mortar-${pkgver}/build/appicon.svg" \
    "${pkgdir}/usr/share/icons/hicolor/scalable/apps/tech.rethunk.Mortar.svg"
  install -Dm644 "mortar-${pkgver}/LICENSE" \
    "${pkgdir}/usr/share/doc/mortar/LICENSE"
  install -Dm644 "mortar-${pkgver}/THIRD_PARTY_NOTICES" \
    "${pkgdir}/usr/share/doc/mortar/THIRD_PARTY_NOTICES"
}
