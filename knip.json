{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreBinaries": ["appstreamcli", "bwrap", "cwebp", "go", "govulncheck", "ss", "wails3"],
  "ignore": ["web/public/vendor/**"],
  "workspaces": {
    ".": {
      "entry": ["scripts/site-demo.ts"],
      "project": ["scripts/**/*.ts"]
    },
    "frontend": {
      "entry": [
        "src/main.tsx",
        "lingui.config.ts",
        "vite.config.ts",
        "e2e/mem-budget.ts",
        "e2e/render-budget.ts",
        "e2e/screens.ts",
        "e2e/record-demo.ts",
        "e2e/demo-check.ts",
        "src/demo/entry.ts",
        "vite.demo.config.ts"
      ],
      "vite": false
    },
    "web": {
      "entry": [
        "public/share/app.js",
        "public/download.js",
        "public/games.js",
        "public/search.js",
        "scripts/*.ts",
        "test/*.test.ts"
      ],
      "project": ["**/*.{ts,astro,js}"]
    }
  }
}
