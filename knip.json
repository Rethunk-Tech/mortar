{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreBinaries": ["appstreamcli", "go", "golangci-lint", "govulncheck", "wails3"],
  "ignore": ["site/vendor/**"],
  "workspaces": {
    ".": {
      "entry": ["site/stardew/p/app.js", "site/landing.js", "site/download.js"],
      "project": ["site/**/*.js", "scripts/**/*.ts"]
    },
    "frontend": {
      "entry": ["src/main.tsx", "lingui.config.ts", "vite.config.ts"],
      "vite": false,
      "ignoreDependencies": ["@lingui/native-tools"]
    }
  }
}
