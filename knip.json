{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreBinaries": ["appstreamcli", "bwrap", "cwebp", "go", "govulncheck", "ss", "wails3"],
  "ignore": ["site/vendor/**"],
  "workspaces": {
    ".": {
      "entry": [
        "site/share/app.js",
        "site/landing.js",
        "site/download.js",
        "site/games.js",
        "site/search.js",
        "site/nav.js",
        "site/guide.js",
        "scripts/site-demo.ts"
      ],
      "project": ["site/**/*.js", "scripts/**/*.ts"]
    },
    "frontend": {
      "entry": [
        "src/main.tsx",
        "lingui.config.ts",
        "vite.config.ts",
        "e2e/mem-budget.ts",
        "e2e/render-budget.ts",
        "e2e/screens.ts",
        "e2e/record-demo.ts",
        "e2e/demo-check.ts",
        "src/demo/entry.ts",
        "vite.demo.config.ts"
      ],
      "vite": false
    }
  }
}
