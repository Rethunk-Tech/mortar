{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreBinaries": ["appstreamcli", "bwrap", "go", "govulncheck", "ss", "wails3"],
  "ignore": ["site/vendor/**"],
  "workspaces": {
    ".": {
      "entry": ["site/share/app.js", "site/landing.js", "site/download.js"],
      "project": ["site/**/*.js", "scripts/**/*.ts"]
    },
    "frontend": {
      "entry": [
        "src/main.tsx",
        "lingui.config.ts",
        "vite.config.ts",
        "e2e/mem-budget.ts",
        "e2e/screens.ts"
      ],
      "vite": false,
      "ignoreDependencies": ["@lingui/native-tools"]
    }
  }
}
