msgstr "图片（PNG、JPEG、WebP）"

msgid "Import settings"
msgstr "导入设置"

msgid "Leave it"
msgstr "保留它"

msgid "Mod updates available: {count}"
msgstr "有 {count} 个模组更新可用"

msgid "Mods with errors: {count}"
msgstr "有错误的模组：{count}"

msgid "Mortar cannot edit this file: it is UTF-16 or holds a NUL byte."
msgstr "Mortar 无法编辑此文件：它是 UTF-16 编码或包含 NUL 字节。"

msgid "Mortar could not start:\n\n{error}\n\nThe details are in mortar.log in Mortar's data folder."
msgstr "Mortar 无法启动：\n\n{error}\n\n详细信息见 Mortar 数据文件夹中的 mortar.log。"

msgid "Mortar is already running but has not answered for {count} seconds.\n\nEnd it and start Mortar again? Anything it was doing stops."
msgstr "Mortar 已在运行，但已 {count} 秒没有响应。\n\n要结束它并重新启动 Mortar 吗？它正在进行的任何操作都会停止。"

msgid "Mortar needs the {runtime}, which does not seem to be installed.\n\nYes: Open the download page (install the {installer}, then start Mortar again)\nNo: Start anyway"
msgstr "Mortar 需要 {runtime}，但似乎尚未安装。\n\n是：打开下载页面（安装 {installer}，然后重新启动 Mortar）\n否：仍然启动"

msgid "Mortar profile (.mortar)"
msgstr "Mortar 配置（.mortar）"

msgid "Mortar profile backup"
msgstr "Mortar 配置备份"

msgid "Mortar profile backup (zip)"
msgstr "Mortar 配置备份（zip）"

msgid "Mortar stopped because of an error:\n\n{error}\n\nThe details are in crash.log in {path}."
msgstr "Mortar 因错误而停止：\n\n{error}\n\n详细信息见 {path} 中的 crash.log。"

msgid "Mortar stopped while starting:\n\n{error}\n\nThe details are in crash.log in Mortar's data folder."
msgstr "Mortar 在启动时停止：\n\n{error}\n\n详细信息见 Mortar 数据文件夹中的 crash.log。"

msgid "Mortar's data folder was not found:\n\n{path}\n\nIts drive may be unplugged. Plug it in and choose Cancel, then start Mortar again, or choose here:\n\nYes: Use the default location\nNo: Choose the data folder…\nCancel: Quit"
msgstr "未找到 Mortar 数据文件夹：\n\n{path}\n\n其所在驱动器可能已拔出。请插好驱动器并选择“取消”，然后重新启动 Mortar，或者在此选择：\n\n是：使用默认位置\n否：选择数据文件夹…\n取消：退出"

msgid "Mortar's data folder was not found:\n\n{path}\n\nIts drive may be unplugged. Plug it in and choose {quit}, then start Mortar again, or choose here."
msgstr "未找到 Mortar 数据文件夹：\n\n{path}\n\n其所在驱动器可能已拔出。请插好驱动器并选择 {quit}，然后重新启动 Mortar，或者在此选择。"

