# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

# gofmt indents with tabs.
[{*.go,go.mod}]
indent_style = tab
indent_size = 4

# Trailing double spaces are hard line breaks in Markdown.
[*.md]
trim_trailing_whitespace = false
