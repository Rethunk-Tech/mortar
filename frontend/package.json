{
  "name": "mortar-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "bun@1.4.3",
  "scripts": {
    "dev": "lingui compile --typescript && vite",
    "build:dev": "lingui compile --typescript && bun ../scripts/gen-credits.ts && tsc && vite build --minify false --mode development",
    "build": "lingui extract --clean && lingui compile --typescript && bun ../scripts/gen-credits.ts && bun ../scripts/i18n-completeness.ts && tsc && vite build --mode production",
    "preview": "vite preview",
    "catalogs": "lingui compile --typescript",
    "i18n:extract": "lingui extract --clean",
    "i18n:compile": "lingui compile --typescript && bun ../scripts/i18n-completeness.ts",
    "i18n:dupes": "bun ../scripts/i18n-dupes.ts",
    "e2e": "bun e2e/run-shards.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@fontsource/open-sans": "5.3.0",
    "@lingui/core": "6.10.1",
    "@lingui/react": "6.10.1",
    "@mui/material": "9.5.0",
    "@tanstack/react-virtual": "3.14.23",
    "@wailsio/runtime": "3.0.0",
    "lucide-react": "1.63.0",
    "react": "19.3.1",
    "react-colorful": "5.8.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "simple-icons": "16.36.0",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@babel/core": "^8.0.9",
    "@happy-dom/global-registrator": "^21.0.4",
    "@lingui/babel-plugin-lingui-macro": "^6.10.1",
    "@lingui/cli": "6.10.1",
    "@lingui/conf": "6.10.1",
    "@lingui/format-po": "6.10.1",
    "@lingui/native-tools": "^0.2.0",
    "@lingui/vite-plugin": "6.10.1",
    "@playwright/test": "1.64.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/babel__core": "^7.20.5",
    "@types/bun": "1.4.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "7.0.2",
    "vite": "^8.3.5"
  }
}
