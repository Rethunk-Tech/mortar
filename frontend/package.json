{
  "name": "mortar-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "dev": "vite",
    "build:dev": "bun ../scripts/gen-credits.ts && tsc && vite build --minify false --mode development",
    "build": "bun ../scripts/gen-credits.ts && lingui extract --clean && lingui compile --typescript && tsc && vite build --mode production",
    "preview": "vite preview",
    "i18n:extract": "lingui extract --clean",
    "i18n:compile": "lingui compile --typescript",
    "i18n:dupes": "bun ../scripts/i18n-dupes.ts",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@fontsource/open-sans": "5.3.0",
    "@lingui/core": "6.9.0",
    "@lingui/react": "6.9.0",
    "@mui/material": "9.4.0",
    "@tanstack/react-virtual": "3.14.13",
    "@wailsio/runtime": "3.0.0-beta.27",
    "lucide-react": "1.52.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "simple-icons": "16.34.0",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@lingui/cli": "6.9.0",
    "@lingui/conf": "6.9.0",
    "@lingui/native-tools": "^0.1.5",
    "@lingui/vite-plugin": "6.9.0",
    "@playwright/test": "1.63.0",
    "@types/bun": "1.4.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "7.0.2",
    "vite": "^8.3.2"
  }
}
