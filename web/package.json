{
  "name": "mortar-web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun scripts/vendor.ts && bun --bun astro dev --host 0.0.0.0",
    "build": "bun scripts/vendor.ts && bun --bun astro build && bun ../scripts/site-demo.ts ../site/demo && bun scripts/check.ts",
    "check": "astro sync && tsc -b --noEmit --pretty false",
    "preview": "astro preview --host 0.0.0.0",
    "refresh": "bun scripts/refresh.ts"
  },
  "dependencies": {
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.6",
    "@fontsource/atkinson-hyperlegible-next": "5.3.0",
    "@resvg/resvg-js": "2.6.2",
    "astro": "7.4.13",
    "brotli-dec-wasm": "2.3.2",
    "satori": "0.63.2",
    "simple-icons": "16.38.1",
    "typescript": "7.0.2"
  },
  "devDependencies": {
    "@types/bun": "1.4.5"
  }
}
