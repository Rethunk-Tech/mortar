<Base
  title="Download Mortar"
  description="Download Mortar for Windows, Linux or the Steam Deck: installer, AppImage, Flatpak, and signed apt, dnf and pacman repositories that keep it up to date."
  current="download"
  crumbs={[{ name: 'Download', href: '/download/' }]}
  band={false}
>
  <header class="wrap pagehead">
    <p class="kicker">Download</p>
    <h1>Get Mortar. <em>It's free.</em></h1>
    <p class="lede">It's open source too. <span id="version">The latest release</span> runs on Windows and Linux, x64 and ARM64, and on the Steam Deck.</p>
  </header>
  <div class="wrap sec dl">
<p class="forsys jsonly">For <b id="sysname">your system</b>. <button type="button" class="linkish" id="other" aria-expanded="false" aria-controls="systems">Not your system?</button></p>
<div class="tabs" id="systems" role="tablist" aria-label="Platform">
  <button
    type="button"
    role="tab"
    id="tab-windows"
    aria-controls="windows"
  ><svg class="mk mk-windows" aria-hidden="true"><use href="/img/brands.svg#windows" /></svg>Windows</button>
  <button type="button" role="tab" id="tab-linux" aria-controls="linux"><svg class="mk mk-linux" aria-hidden="true"><use href="/img/brands.svg#linux" /></svg>Linux</button>
  <button type="button" role="tab" id="tab-deck" aria-controls="deck"><svg class="mk mk-steamdeck" aria-hidden="true"><use href="/img/brands.svg#steamdeck" /></svg>Steam Deck</button>
