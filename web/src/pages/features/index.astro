---
import Page from '../../layouts/Page.astro'
import { playableGames } from '../../lib/games.ts'
import '../../styles/landing.css'
import '../../styles/landing-features.css'
import '../../styles/landing-compare.css'

const games = playableGames().length
const glance = [
  ['Finds your game', 'Steam, GOG, Epic, the EA app, Heroic, Lutris and more'],
  ['Installs the mod loader', 'SMAPI or BepInEx, kept up to date'],
  ['Every mod site', 'Nexus Mods, Thunderstore, CurseForge and more'],
  ['Free', 'AGPL-3.0, no account needed'],
]
const sections = [
  {
    title: 'A profile for every playthrough',
    text: 'A vanilla-plus farm, an Expanded run and your crew\'s Lethal Company pack, side by side. Each has its own mods, settings and launch options.',
    ticks: [
      'Install, update and roll back per profile',
      'Read the changelog before you update',
      'Start new profiles from templates',
      'Freeze a profile on its current versions',
      'Install any version, not only the newest',
      'Star your favourite mods and profiles',
      'Scheduled save backups, with a timeline per save',
    ],
    img: 'profile',
    alt: "A mod's detail panel in Mortar with its version, update channel and Keep this version",
  },
  {
    title: 'Stardew Valley on SMAPI',
    text: 'Mortar installs and updates SMAPI, and handles hundreds of mods with cover art, groups and filters.',
    ticks: [
      'Nexus Mod Manager Download lands in the right profile',
      'Import Nexus collections with their FOMOD choices',
      'SMAPI options per game or per profile',
    ],
    img: 'mods',
    alt: 'Mortar showing a Stardew Valley profile of 805 mods with cover art',
  },
  {
    title: 'Lethal Company, Valheim and more on BepInEx',
    text: "Mortar installs each game's BepInEx pack and keeps packages in the profile, not the game folder. On Linux, Valheim's native build runs modded without Proton.",
    ticks: [
      'Plugin settings travel with the profile',
      'Plugins that failed to load or ship twice show in Problems',
      'Import r2modman or Gale profiles; export a Thunderstore modpack',
      'Falls back across Thunderstore download servers',
      'Dedicated server profiles for Valheim and Risk of Rain 2',
      "Friends check their mods against the host's list",
    ],
    img: 'lethal-company',
    alt: 'A Lethal Company profile in Mortar with its Thunderstore mods',
  },
  {
    title: 'Every mod site in one search',
    text: 'Browse searches every site the game uses at once. Dependencies come along.',
    ticks: [
      'Filter by category; sort by downloads or update',
      'Mods the profile already has are marked',
      "Every download comes from the mod's own page",
      'Hide a mod or an author',
      'Modpacks, translations and cheats start excluded',
    ],
    img: 'thunderstore',
    alt: 'The Browse tab listing Lethal Company packages from Thunderstore',
  },
  {
    title: 'Know what broke before you launch',
    text: 'Missing dependencies, outdated versions and content conflicts, in plain words, each with a fix.',
    ticks: [
      'Missing dependencies queued for you',
      'Content conflicts explained file by file',
      'One-click fixes',
      'After a crash, the mod whose code was running is named',
    ],
    img: 'problems',
    alt: 'The Problems tab explaining which mod wins each content conflict',
  },
  {
    title: 'See what slows your startup',
    text: 'Time to the title screen and what each mod costs, so a slow load has a name.',
    ticks: ['Compared with the last launch', 'Per-mod startup and in-game cost', 'Game console and logs inside Mortar'],
    img: 'performance',
    alt: "The Performance tab with time to title screen and each mod's startup cost",
  },
  {
    title: 'Play from Steam Deck Game Mode',
    text: 'Add a profile to Steam and start it from Game Mode. Mortar stays out of sight and closes with the game, so Steam counts your playtime.',
    ticks: [
      'Full gamepad control',
      "Laid out for the Deck's 1280×800 screen",
      'Diagnostics for Desktop and Game Mode',
    ],
    img: 'deck',
    alt: 'Game select at the Steam Deck’s resolution with the Lethal Company row focused by a gamepad',
  },
  {
    title: 'Your profiles on all your PCs',
    text: 'Pair two computers with a short code. A profile arrives with its mod files, so nothing downloads twice. No account.',
    ticks: [
      'Finds nearby computers',
      'The code works once, for five minutes',
      'Unpaired computers download each mod instead',
    ],
    img: 'pairing',
    alt: 'The Pair a computer dialog showing a one-time pairing code',
  },
  {
    title: 'Scanned before it installs',
    text: "Each mod goes past your antivirus before it reaches the game: Windows' scanner, ClamAV or your own command.",
    ticks: [],
    img: 'settings',
    alt: 'General settings with the antivirus choices: Automatic, clamd socket, custom command or off',
  },
]
---

<Page
  title="Mortar features: profiles, every mod site, Problems and more"
  description={`Everything Mortar does for the ${games} games it supports: a profile per playthrough, one search across every mod site, problems explained before you launch, Steam Deck Game Mode and more.`}
  heading="Every feature."
  kicker="Features"
  lede="Built for hundreds of mods, several playthroughs and friends on the same pack."
  crumbs={[{ name: 'Features', href: '/features/' }]}
  current="features"
  full
>
  <dl class="glance">
    {
      glance.map(([k, v]) => (
        <div>
          <dt>{k}</dt>
          <dd>{v}</dd>
        </div>
      ))
    }
  </dl>
  <p class="dim">
    <a href="/download/">Download</a> for Windows or Linux. <a href="/games/">{games} games</a> supported.
  </p>

  {
    sections.map((s, i) => (
      <section class:list={['wide', 'spot', 'feature-row', { rev: i % 2 === 1 }]}>
        <div>
          <h2>{s.title}</h2>
          <p class="dim">{s.text}</p>
          {s.ticks.length > 0 && (
            <ul>
              {s.ticks.map((t) => (
                <li>{t}</li>
              ))}
            </ul>
          )}
        </div>
        <div class="shot">
          <img class="zoom" src={`/img/${s.img}.webp`} alt={s.alt} width="1280" height="800" loading="lazy" />
        </div>
      </section>
    ))
  }

  <section class="companions">
    <p class="kicker">Companions</p>
    <h2>Works with your browser and your game.</h2>
    <p class="dim">Two optional, open source add-ons, installed from inside Mortar.</p>
    <div class="duo">
      <div class="companion">
        <h3>Browser extension</h3>
        <p class="dim">Marks Nexus Mods and Thunderstore pages with what your profile has, and sends downloads to Mortar. Firefox and Chromium browsers.</p>
        <p class="links">
          <a class="btn ghost" href="/extension/">About the extension</a>
          <a class="btn ghost" href="https://github.com/Rethunk-Tech/mortar-browser-extension"><svg aria-hidden="true"><use href="/img/brands.svg#github"></use></svg>Source</a>
        </p>
      </div>
      <div class="companion">
        <h3>Game bridge</h3>
        <p class="dim">A small mod in each profile. In Stardew Valley it runs console commands, exposes GMCM settings, times startup and drives a stream overlay. In BepInEx games it reports which plugins loaded.</p>
        <p class="links">
          <a class="btn ghost" href="https://github.com/Rethunk-Tech/mortar-smapi-bridge"><svg aria-hidden="true"><use href="/img/brands.svg#github"></use></svg>SMAPI bridge</a>
          <a class="btn ghost" href="https://github.com/Rethunk-Tech/mortar-bepinex-bridge"><svg aria-hidden="true"><use href="/img/brands.svg#github"></use></svg>BepInEx bridge</a>
        </p>
      </div>
    </div>
  </section>
</Page>

<style>
  .glance {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: 14px;
    margin: 0 0 18px;
  }
  .glance div {
    background: var(--raised);
    border: 1px solid var(--line);
    border-radius: 14px;
    padding: 16px 18px;
  }
  .glance dt {
    font-weight: 700;
  }
  .glance dd {
    margin: 4px 0 0;
    color: var(--dim);
    font-size: 15px;
  }
  .feature-row {
    padding-top: 80px;
  }
  .feature-row h2 {
    margin-top: 0;
  }
  .companions {
    padding-top: 100px;
  }
  .duo {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px;
    margin-top: 24px;
  }
  .companion {
    padding: 26px;
    border-radius: 16px;
    border: 1px solid var(--line);
    background: linear-gradient(160deg, rgba(214, 177, 122, 0.08), transparent 60%), var(--raised);
  }
  .companion h3 {
    margin: 0 0 8px;
  }
  .companion .links {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin: 18px 0 0;
  }
  .companion .btn {
    font-size: 15px;
    padding: 9px 14px;
  }
  @media (max-width: 900px) {
    .duo {
      grid-template-columns: 1fr;
    }
  }
</style>
