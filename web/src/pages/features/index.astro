---
import Mark from '../../components/Mark.astro'
import Page from '../../layouts/Page.astro'
import { loaderFamilies, modSites, playableGames, SOURCE_NAMES, STORE_NAMES } from '../../lib/games.ts'
import '../../styles/landing.css'
import '../../styles/landing-features.css'
import '../../styles/landing-compare.css'

const games = playableGames().length
const SHOWN_LOADERS = 2
const stores = ['steam', 'gog', 'epic', 'ea', 'lutris', 'xbox']
const loaders = loaderFamilies()
const sites = modSites()
const sections = [
  {
    title: 'A profile for every playthrough',
    text: 'Each has its own mods, settings and launch options.',
    ticks: ['Install any version, and roll back', 'Read the changelog before you update', 'Freeze a profile on its versions'],
    img: 'profile',
    alt: "A mod's detail panel in Mortar with its version, update channel and Keep this version",
  },
  {
    title: 'Stardew Valley on SMAPI',
    text: 'SMAPI installed and kept current, and hundreds of mods with cover art.',
    ticks: ['Nexus Mod Manager Download lands in the right profile', 'Nexus collections with their FOMOD choices'],
    img: 'mods',
    alt: 'Mortar showing a Stardew Valley profile of 805 mods with cover art',
  },
  {
    title: 'BepInEx games',
    text: "Lethal Company, Valheim and more, with packages kept in the profile, not the game folder.",
    ticks: ['Import r2modman or Gale profiles', 'Failed or duplicate plugins show in Problems', 'Dedicated server profiles'],
    img: 'lethal-company',
    alt: 'A Lethal Company profile in Mortar with its Thunderstore mods',
  },
  {
    title: 'Every mod site in one search',
    text: 'Every site the game uses, searched at once. Dependencies come along.',
    ticks: ['Mods you already have are marked', "Every download comes from the mod's own page"],
    img: 'thunderstore',
    alt: 'The Browse tab listing Lethal Company packages from Thunderstore',
  },
  {
    title: 'Know what broke before you launch',
    text: 'Missing dependencies, outdated versions and conflicts, in plain words.',
    ticks: ['One-click fixes', 'After a crash, the mod at fault is named'],
    img: 'problems',
    alt: 'The Problems tab explaining which mod wins each content conflict',
  },
  {
    title: 'See what slows your startup',
    text: 'Time to the title screen and what each mod costs.',
    ticks: ['Compared with the last launch', 'Console and logs inside Mortar'],
    img: 'performance',
    alt: "The Performance tab with time to title screen and each mod's startup cost",
  },
  {
    title: 'Play from Steam Deck Game Mode',
    text: 'Add a profile to Steam and play it from Game Mode.',
    ticks: ['Full gamepad control', "Laid out for the Deck's screen"],
    img: 'deck',
    alt: 'Game select at the Steam Deck’s resolution with the Lethal Company row focused by a gamepad',
  },
  {
    title: 'Your profiles on all your PCs',
    text: 'Pair two computers with a short code. Profiles arrive with their mod files.',
    ticks: ['No account', 'Nearby computers are found for you'],
    img: 'pairing',
    alt: 'The Pair a computer dialog showing a one-time pairing code',
  },
  {
    title: 'Scanned before it installs',
    text: "Each mod goes past your antivirus first: Windows' scanner, ClamAV or your own command.",
    ticks: [],
    img: 'settings',
    alt: 'General settings with the antivirus choices: Automatic, clamd socket, custom command or off',
  },
]
---

<Page
  title="Mortar features: profiles, every mod site, Problems and more"
  description={`Everything Mortar does for the ${games} games it supports: a profile per playthrough, one search across every mod site, problems explained before you launch, Steam Deck Game Mode and more.`}
  heading="Every feature."
  kicker="Features"
  lede="Built for hundreds of mods, several playthroughs and friends on the same pack."
  crumbs={[{ name: 'Features', href: '/features/' }]}
  current="features"
  full
>
  <dl class="glance">
    <div>
      <dt>Finds your game</dt>
      <dd>On every store and launcher, or in a folder you pick.</dd>
      <div class="vis">{stores.map((s) => <Mark site={s} label={STORE_NAMES[s] ?? s} />)}</div>
    </div>
    <div>
      <dt>Installs the mod loader</dt>
      <dd>And keeps it up to date.</dd>
      <div class="vis">
        {loaders.slice(0, SHOWN_LOADERS).map((n) => <span class="pill ok">{n}</span>)}
        {loaders.length > SHOWN_LOADERS && <span class="pill">+ {loaders.length - SHOWN_LOADERS}</span>}
      </div>
    </div>
    <div>
      <dt>Every mod site</dt>
      <dd>{sites.length} sites, searched at once.</dd>
      <div class="vis">{sites.map((s) => <Mark site={s} label={SOURCE_NAMES[s] ?? s} />)}</div>
    </div>
    <div>
      <dt>Free</dt>
      <dd>No account, no ads, open source.</dd>
      <div class="vis"><span class="pill ok">AGPL-3.0</span><span class="pill">$0</span></div>
    </div>
  </dl>
  <p class="dim">
    <a href="/download/">Download</a> for Windows or Linux. <a href="/games/">{games} games</a> supported.
  </p>

  {
    sections.map((s, i) => (
      <section class:list={['wide', 'spot', 'feature-row', { rev: i % 2 === 1 }]}>
        <div>
          <h2>{s.title}</h2>
          <p class="dim">{s.text}</p>
          {s.ticks.length > 0 && (
            <ul>
              {s.ticks.map((t) => (
                <li>{t}</li>
              ))}
            </ul>
          )}
        </div>
        <div class="shot">
          <img class="zoom" src={`/img/${s.img}.webp`} alt={s.alt} width="1280" height="800" loading="lazy" />
        </div>
      </section>
    ))
  }

  <section class="companions">
    <p class="kicker">Companions</p>
    <h2>Works with your browser and your game.</h2>
    <p class="dim">Two optional, open source add-ons, installed from inside Mortar.</p>
    <div class="duo">
      <div class="companion">
        <h3>Browser extension</h3>
        <p class="dim">Marks Nexus Mods, Thunderstore and four more mod sites with what your profile has, and sends downloads to Mortar. Firefox and Chromium browsers.</p>
        <p class="links">
          <a class="btn ghost" href="/extension/">About the extension</a>
          <a class="btn ghost" href="https://github.com/Rethunk-Tech/mortar-browser-extension"><svg aria-hidden="true"><use href="/img/brands.svg#github"></use></svg>Source</a>
        </p>
      </div>
      <div class="companion">
        <h3>Game bridge</h3>
        <p class="dim">A small mod in each profile. It runs console commands and times startup in Stardew Valley, and reports which plugins loaded in BepInEx games.</p>
        <p class="links">
          <a class="btn ghost" href="https://github.com/Rethunk-Tech/mortar-smapi-bridge"><svg aria-hidden="true"><use href="/img/brands.svg#github"></use></svg>SMAPI bridge</a>
          <a class="btn ghost" href="https://github.com/Rethunk-Tech/mortar-bepinex-bridge"><svg aria-hidden="true"><use href="/img/brands.svg#github"></use></svg>BepInEx bridge</a>
        </p>
      </div>
    </div>
  </section>
</Page>

<style>
  .glance {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: 14px;
    margin: 0 0 18px;
  }
  .glance > div {
    display: flex;
    flex-direction: column;
    background: var(--raised);
    border: 1px solid var(--line);
    border-radius: 14px;
    padding: 18px;
  }
  .glance .vis {
    margin-top: auto;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    align-items: center;
    padding-top: 14px;
  }
  .glance .vis :global(.mark) {
    width: 24px;
    height: 24px;
    border-radius: 6px;
  }
  .glance dt {
    font-weight: 700;
  }
  .glance dd {
    margin: 4px 0 0;
    color: var(--dim);
    font-size: 15px;
  }
  .feature-row {
    padding-top: 80px;
  }
  .feature-row h2 {
    margin-top: 0;
  }
  .companions {
    padding-top: 100px;
  }
  .duo {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px;
    margin-top: 24px;
  }
  .companion {
    padding: 26px;
    border-radius: 16px;
    border: 1px solid var(--line);
    background: linear-gradient(160deg, rgba(214, 177, 122, 0.08), transparent 60%), var(--raised);
  }
  .companion h3 {
    margin: 0 0 8px;
  }
  .companion .links {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin: 18px 0 0;
  }
  .companion .btn {
    font-size: 15px;
    padding: 9px 14px;
  }
  @media (max-width: 900px) {
    .duo {
      grid-template-columns: 1fr;
    }
  }
</style>
