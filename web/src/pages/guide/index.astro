---
import Page from '../../layouts/Page.astro'
import { guideAnchors, guideIntro, guideSections } from '../../lib/guide.ts'

const FIRST_TEXT = /<(?:p|li)>(.*?)<\/(?:p|li)>/s
const TAG = /<[^>]+>/g
const SPACE = /\s+/g
// Each page's first sentence or line, as the card's summary.
const summary = (html: string) =>
  (FIRST_TEXT.exec(html)?.[1] ?? '').replace(TAG, '').replace(SPACE, ' ').trim()
const sections = guideSections()
---

<Page
  title="Mortar user guide"
  description="How to install Mortar, add and update mods, keep profiles, share them, play and read Problems, for every game Mortar supports."
  heading="User guide"
  kicker="Guide"
  lede="Everything Mortar does, a page per topic."
  current="guide"
  crumbs={[{ name: 'Guide', href: '/guide/' }]}
  full
>
  <div class="prose guide-intro" set:html={guideIntro()} />
  <ol class="tile-grid guide-index">
    {
      sections.map((s, i) => (
        <li>
          <a class="guide-card" href={`/guide/${s.slug}/`}>
            <span class="num">{String(i + 1).padStart(2, '0')}</span>
            <b set:html={s.title} />
            <span class="sum">{summary(s.html)}</span>
          </a>
        </li>
      ))
    }
  </ol>
  <script is:inline type="application/json" id="guide-anchors" set:html={JSON.stringify(guideAnchors())} />
</Page>

<script>
  // The guide used to be one page: /guide/#<heading> still lands on the page that holds that heading.
  const id = decodeURIComponent(location.hash.slice(1))
  const anchors = JSON.parse(document.getElementById('guide-anchors')?.textContent ?? '{}') as Record<string, string>
  const page = anchors[id]
  if (page) {
    location.replace(page === id ? `/guide/${page}/` : `/guide/${page}/#${id}`)
  }
</script>

<style>
  .guide-intro {
    margin-bottom: 28px;
  }
  .guide-index {
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 19rem), 1fr));
    grid-auto-rows: 1fr;
  }
  .guide-card {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 18px 20px 20px;
    border: 1px solid var(--line);
    border-radius: 16px;
    background: var(--raised);
    transition:
      border-color 0.2s,
      transform 0.2s;
  }
  .guide-card:hover {
    border-color: var(--sand);
    transform: translateY(-3px);
  }
  .guide-card .num {
    color: var(--sand);
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 0.1em;
  }
  .guide-card b {
    font-size: 18px;
    line-height: 1.25;
  }
  .guide-card .sum {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    overflow: hidden;
    color: var(--dim);
    font-size: 15px;
  }
</style>
