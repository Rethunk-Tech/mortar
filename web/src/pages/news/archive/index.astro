---
import NewsItem from '../../../components/NewsItem.astro'
import Page from '../../../layouts/Page.astro'
import { posts } from '../../../lib/news.ts'

const all = await posts()
---

<Page
  title="Mortar news archive"
  description="Every Mortar release post and how-to."
  heading="Archive"
  kicker="News"
  lede={'Every release post and how-to. <a href="/news/rss.xml">RSS feed</a>.'}
  current="news"
  crumbs={[
    { name: 'News', href: '/news/' },
    { name: 'Archive', href: '/news/archive/' },
  ]}
>
  <ul class="post-list">
    {
      all.map((p) => (
        <li>
          <a class="post" href={`/news/${p.slug}/`}>
            <NewsItem post={p} />
          </a>
        </li>
      ))
    }
  </ul>
</Page>
