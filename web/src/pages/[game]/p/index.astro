---
import type { GetStaticPaths } from 'astro'
import Base from '../../../layouts/Base.astro'
import { steamArt } from '../../../lib/art.ts'
import { shareMarks } from '../../../lib/brands.ts'
import { artOf, type Game, playableGames } from '../../../lib/games.ts'
import '../../../styles/page.css'
import '../../../styles/page-lists.css'

export const getStaticPaths = (() =>
  playableGames().map((g) => ({
    params: { game: g.id },
    props: { game: g },
  }))) satisfies GetStaticPaths

interface Props {
  game: Game
}

// The page a shared profile link opens (/<game>/p#<payload>): /share/app.js reads the payload in the browser, so the
// profile never reaches a server.
const { game } = Astro.props
const hero = artOf(game, steamArt())?.hero
---

<Base
  title={`Mortar: shared ${game.name} profile`}
  description={`A ${game.name} mod profile shared from Mortar.`}
  unlisted
>
  <header slot="before" class:list={['banner', { plain: !hero }]} style={hero ? `--hero: url('${hero}')` : undefined}>
    <div class="wrap">
      <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Mortar</a> › <a href="/games/">Games</a> › <a href={`/${game.id}/`}>{game.name}</a></nav>
      <h1>Shared {game.name} profile</h1>
    </div>
  </header>
  <div class="wrap pagebody prose full share">
    <p id="error" class="card" hidden></p>
    <noscript><p class="card">This page needs JavaScript to read the shared profile.</p></noscript>
    <section id="profile" hidden>
      <p id="name" class="title"></p>
      <p class="muted"><span id="count"></span>. Mortar resolves mod names when you import.</p>
      <label id="versionRow" hidden>Your game version
        <input id="version" inputmode="decimal" autocomplete="off" />
        <span id="flagged" class="muted"></span>
      </label>
      <ul id="list" data-marks={JSON.stringify(shareMarks())}></ul>
    </section>
    <div class="actions">
      <a id="open" class="btn primary" href="mortar://" hidden>Open in Mortar</a>
      <a id="download" class="btn ghost" href="/download/" hidden>Get Mortar</a>
    </div>
    <p id="copied" class="muted" hidden>Link copied. After installing Mortar, paste it into Import.</p>
    <h2>What is Mortar?</h2>
    <p>A free, open source mod manager for Linux, Windows and Steam Deck. It installs each game's mod loader, keeps each set of mods in its own profile and downloads every mod from its own page. <a href={`/${game.id}/`}>How Mortar handles {game.name}</a></p>
    <p class="muted">Everything on this page happens in your browser; the profile is never sent anywhere. Pictures of GitHub and Thunderstore mods load from those sites.</p>
  </div>
</Base>

<script is:inline type="module" src="/share/app.js"></script>

<style is:global>
:root {
  --error: rgb(199, 10, 10);
  --warn: rgb(240, 180, 60);
}
.title {
  margin: 0;
  font-size: 1.5rem;
  font-weight: 500;
  overflow-wrap: anywhere;
}
#list {
  list-style: none;
  margin: 1rem 0 0;
  padding: 0;
  /* The profile's mods use the page's full width, not the prose column's. */
  max-width: none;
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr));
  gap: 0.75rem;
}
#list li {
  margin: 0;
  display: grid;
  grid-template-columns: 40px 1fr;
  column-gap: 0.75rem;
  align-items: center;
  padding: 0.6rem;
  background: rgba(255, 255, 255, 0.04);
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 8px;
  overflow-wrap: anywhere;
}
.picwrap {
  position: relative;
  grid-row: 1 / span 2;
  width: 40px;
  height: 40px;
}
.badge {
  position: absolute;
  right: -5px;
  bottom: -5px;
  display: grid;
  place-items: center;
  width: 18px;
  height: 18px;
  padding: 2px;
  border-radius: 5px;
  background: var(--bg);
}
.badge svg,
.badge img {
  width: 100%;
  height: 100%;
}
.pic {
  display: block;
  width: 40px;
  height: 40px;
  border-radius: 6px;
  background: rgba(255, 255, 255, 0.06);
  object-fit: cover;
}
.meta {
  font-size: 0.8rem;
  opacity: 0.7;
}
.flag {
  grid-column: 1 / -1;
  margin-top: 0.3rem;
  font-size: 0.8rem;
  color: var(--warn);
}
.flag[hidden],
#versionRow[hidden] {
  display: none;
}
#versionRow {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 0.5rem;
  margin-top: 0.75rem;
  font-size: 0.9rem;
}
#version {
  width: 6rem;
  padding: 0.2rem 0.4rem;
  font: inherit;
  color: inherit;
  background: transparent;
  border: 1px solid rgba(255, 255, 255, 0.3);
  border-radius: 4px;
}
.actions {
  display: flex;
  flex-wrap: wrap;
  gap: 0.75rem;
  margin-top: 1.25rem;
}
#error {
  border-left: 4px solid var(--error);
}
.card[hidden],
.btn[hidden] {
  display: none;
}
  .share .card {
    padding: 16px 18px;
  }
  .share .muted {
    color: var(--dim);
  }
</style>
