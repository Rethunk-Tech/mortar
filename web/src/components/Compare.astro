---
import { managers } from '../lib/compare.ts'
import CompareCell from './CompareCell.astro'

const ms = managers()
type Row = [
  label: string,
  cell: (m: (typeof ms)[number]) => { kind: string; value: string | string[] | undefined },
]
const groups: [string, Row[]][] = [
  [
    'Reach',
    [
      ['Games', (m) => ({ kind: 'num', value: m.games })],
      ['Mod sites', (m) => ({ kind: 'sites', value: m.sites })],
      ['Runs on', (m) => ({ kind: 'platforms', value: m.platforms })],
    ],
  ],
  [
    'Sharing',
    [
      ['Shares as', (m) => ({ kind: 'tags', value: m.shares })],
      ['Opens', (m) => ({ kind: 'tags', value: m.opens })],
      ['Imports profiles from', (m) => ({ kind: 'imports', value: m.imports })],
    ],
  ],
  [
    'Everyday',
    [
      ['Account needed', (m) => ({ kind: 'text', value: m.account })],
      ['Usage analytics', (m) => ({ kind: 'text', value: m.analytics })],
      ['Licence', (m) => ({ kind: 'text', value: m.licence })],
    ],
  ],
]
---

<div class="k1wrap">
  <table class="k1">
    <thead>
      <tr>
        <td></td>
        {ms.map((m, i) => (
          <th scope="col" class={i === 0 ? 'us' : undefined}>
            <a class="mgr" href={i === 0 ? '/mission/' : `/why/${m.id}/`}><img src={m.logo} alt="" width="28" height="28" />{m.name}</a>
          </th>
        ))}
      </tr>
    </thead>
    <tbody>
      {groups.map(([g, rows]) => (
        <>
          <tr class="group"><th colspan={ms.length + 1} scope="colgroup">{g}</th></tr>
          {rows.map(([label, cell]) => (
            <tr>
              <th scope="row">{label}</th>
              {ms.map((m, i) => {
                const c = cell(m)
                return (
                  <td class={i === 0 ? 'us' : undefined}>
                    <CompareCell kind={c.kind} value={c.value} />
                  </td>
                )
              })}
            </tr>
          ))}
        </>
      ))}
    </tbody>
  </table>
</div>
<p class="foot-note">A dash means the project's own documentation does not mention it. Each manager's column links to a comparison that cites its sources.</p>
