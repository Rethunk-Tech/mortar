---
import { DISCORD, REPO } from '../lib/site.ts'

interface Props {
  current?: string | undefined
}

const { current } = Astro.props
// `sec` names the landing page section a link follows while that page scrolls.
const links = [
  { href: '/games/', label: 'Games', id: 'games', sec: 'games' },
  { href: '/#features', label: 'Features', id: 'features', sec: 'features' },
  { href: '/news/', label: 'News', id: 'news', sec: 'news' },
  { href: '/why/', label: 'Compare', id: 'why', sec: 'compare' },
  { href: '/guide/', label: 'Guide', id: 'guide' },
  { href: '/faq/', label: 'FAQ', id: 'faq' },
]
const outbound = [
  { href: REPO, label: 'GitHub', id: 'github' },
  { href: DISCORD, label: 'Discord', id: 'discord' },
]
---

<nav class="nav" aria-label="Main">
  <div class="progress" id="progress"></div>
  <div class="wrap">
    <a class="brand" href="/"><img src="/img/icon-192.png" width="30" height="30" alt="" />Mortar</a>
    <div class="links">
      {
        links.map((l) => (
          <a href={l.href} data-sec={l.sec} aria-current={current === l.id ? 'page' : undefined}>
            {l.label}
          </a>
        ))
      }
    </div>
    <span class="tools">
      <button type="button" class="nav-search" aria-label="Search" aria-keyshortcuts="Control+K Meta+K">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg>
      </button>
      {
        outbound.map((o) => (
          <a class="optional" href={o.href} title={o.label}>
            <svg aria-hidden="true"><use href={`/img/brands.svg#${o.id}`} /></svg>
            <span class="visually-hidden">{o.label}</span>
          </a>
        ))
      }
      <button type="button" class="nav-menu" aria-label="Menu" aria-expanded="false" aria-controls="nav-drawer">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16"></path></svg>
      </button>
    </span>
    <a class="btn primary" href="/download/" aria-current={current === 'download' ? 'page' : undefined}>Download</a>
  </div>
  <div class="nav-drawer" id="nav-drawer" hidden>
    {links.map((l) => <a href={l.href}>{l.label}</a>)}
    {outbound.map((o) => <a href={o.href}>{o.label}</a>)}
    <a href="/download/">Download</a>
  </div>
</nav>
