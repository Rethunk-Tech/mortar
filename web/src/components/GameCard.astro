---
import type { SteamArt } from '../lib/art.ts'
import { artOf, facts, type Game } from '../lib/games.ts'

interface Props {
  game: Game
  art: Record<string, SteamArt>
  /** Filter data for /games/. */
  data?: Record<string, string>
}

const { game, art, data = {} } = Astro.props
const a = artOf(game, art)
const meta = facts(game).loader || 'No loader needed'
const src = a?.capsule ?? a?.header
---

<li {...Object.fromEntries(Object.entries(data).map(([k, v]) => [`data-${k}`, v]))}>
  <a class:list={['cover', { 'no-art': !src }]} href={`/${game.id}/`}>
    {
      a?.capsule ? (
        <img class="cover-art" src={a.capsule} srcset={a.capsule2x ? `${a.capsule} 1x, ${a.capsule2x} 2x` : undefined} width="300" height="450" alt="" loading="lazy" referrerpolicy="no-referrer" />
      ) : a?.header ? (
        <img class="cover-art" src={a.header} width="460" height="215" alt="" loading="lazy" referrerpolicy="no-referrer" />
      ) : (
        <span class="letter" aria-hidden="true">{game.name.charAt(0)}</span>
      )
    }
    <span class="cover-text"><span class="game-name">{game.name}</span><span class="game-meta">{meta}</span>{data.sources !== undefined && <span class="game-more">{data.sources.split('|').join(', ')}</span>}{data.stores !== undefined && <span class="game-more">{data.stores.split('|').join(', ')}</span>}</span>
  </a>
</li>
