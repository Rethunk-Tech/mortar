---
// The frame of every page: metadata for search and link previews, the nav, the footer and the site-wide script.
import '@fontsource/atkinson-hyperlegible-next/latin-400.css'
import '@fontsource/atkinson-hyperlegible-next/latin-500.css'
import '@fontsource/atkinson-hyperlegible-next/latin-700.css'
import '@fontsource/atkinson-hyperlegible-next/latin-800.css'
import body from '@fontsource/atkinson-hyperlegible-next/files/atkinson-hyperlegible-next-latin-400-normal.woff2?url'
import heading from '@fontsource/atkinson-hyperlegible-next/files/atkinson-hyperlegible-next-latin-800-normal.woff2?url'
import '../styles/site.css'
import '../styles/site-motion.css'
import Footer from '../components/Footer.astro'
import Nav from '../components/Nav.astro'
import { appLd, breadcrumbLd, type Crumb, ogPath } from '../lib/seo.ts'
import { SITE } from '../lib/site.ts'

interface Props {
  title: string
  description: string
  /** The nav link this page belongs under. */
  current?: string | undefined
  /** Not for search engines or the site search: a shared profile, a redirect, the 404. */
  unlisted?: boolean | undefined
  /** The trail to this page after the home page; the last entry is this page. */
  crumbs?: Crumb[] | undefined
  jsonLd?: object[] | undefined
  /** The footer's "Ready to mod?" band; the download page is already that. */
  band?: boolean
}

const {
  title,
  description,
  current,
  unlisted = false,
  crumbs,
  jsonLd = [],
  band = true,
} = Astro.props
const path = Astro.url.pathname
const url = `${SITE}${path}`
const image = `${SITE}${ogPath(path)}`
const ld = [appLd(), ...(crumbs ? [breadcrumbLd(crumbs)] : []), ...jsonLd]
---

<!doctype html>
<html lang="en" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="referrer" content="no-referrer" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#111114" />
    {unlisted && <meta name="robots" content="noindex" />}
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={url} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Mortar" />
    <meta property="og:url" content={url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="alternate" type="application/rss+xml" title="Mortar news" href={`${SITE}/news/rss.xml`} />
    <link rel="alternate" type="application/atom+xml" title="Mortar releases" href={`${SITE}/changelog/feed.xml`} />
    <!-- Body and heading text arrive before first paint, so the page does not shift when they swap in. -->
    <link rel="preload" href={body} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={heading} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/img/icon-192.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <script is:inline>document.documentElement.classList.remove('no-js')</script>
    {ld.map((o) => <script type="application/ld+json" set:html={JSON.stringify(o)} />)}
    <slot name="head" />
  </head>
  <body id="top">
    <a class="skip" href="#main">Skip to content</a>
    <Nav current={current} />
    <slot name="before" />
    <main id="main" data-pagefind-body={unlisted ? undefined : ''}>
      <slot />
    </main>
    <Footer band={band} />
    <div class="lightbox" id="lightbox" aria-hidden="true"><img alt="" /></div>
    <script>
      import '../scripts/site.ts'
    </script>
    <script is:inline src="/search.js" defer></script>
  </body>
</html>
